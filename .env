# ==============================================================================
# AI TICKET TRIAGE SYSTEM — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Path to the serialized ML model artifact inside the container volume
MODEL_PATH=/app/models/model.joblib

# Application logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application metadata displayed in Swagger / OpenAPI docs (/docs)
API_TITLE=AI Ticket Triage API
API_VERSION=1.0.0

# Optional JSON list of allowed queue categories for response validation context
ALLOWED_QUEUES=["Technical", "Billing", "Account", "General"]
